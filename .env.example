SECRET_KEY=replace-with-a-long-random-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Configuration
# Option 1 (Default): PostgreSQL / Supabase
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-or-postgres-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=prefer

# Supabase Project Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Option 2 (Local Testing Without Supabase): SQLite
# Comment out Option 1 above and uncomment the two lines below:
# ------------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
